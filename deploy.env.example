# Copy to deploy.env (git-ignored) or export these in your shell.
# Docs: docs/CREDENTIALS.md

# ---- Cloudflare (relay) ---------------------------------------------------
# Token: dash.cloudflare.com → My Profile → API Tokens → "Edit Cloudflare Workers"
# Permissions: Account · Workers Scripts · Edit   +   Account · Account Settings · Read
CLOUDFLARE_API_TOKEN=

# 32 hex characters, in the dashboard url: dash.cloudflare.com/<ACCOUNT_ID>
CLOUDFLARE_ACCOUNT_ID=

# Optional: rename the worker (defaults to nullnode)
CLOUDFLARE_WORKER_NAME=nullnode

# ---- GitHub (site) --------------------------------------------------------
# Only needed for non-interactive deploys; `gh auth login` is usually enough.
# Classic PAT scopes: repo, workflow. Fine-grained: Contents RW, Pages RW,
# Workflows RW, Administration RW (Administration only to auto-enable Pages).
GITHUB_TOKEN=
